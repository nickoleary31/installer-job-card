# Zoho FSM auto-publish (Phase 0B): notifies the hosted Zoho FSM orchestrator after a completed
# Installer Sheetz job card is first submitted or an existing completed submission is revised.
# Leaving either of these unset disables auto-publish safely (no-op, nothing fails).
ZOHO_FSM_ORCHESTRATOR_BASE_URL=
ZOHO_FSM_ORCHESTRATOR_ADMIN_TOKEN=
