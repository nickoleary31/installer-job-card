# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Supabase CLI local state: the linked project ref, pooler URL and cached
# service versions written by `supabase link` and other CLI commands. It is
# per-developer and per-environment. A committed copy silently links every
# fresh checkout to that project (it pointed at Production), so select a
# project explicitly (`supabase link --project-ref …` or `--db-url`) before
# any remote CLI command.
/supabase/.temp/
/supabase/.branches/

# typescript
*.tsbuildinfo
next-env.d.ts

# Local draft photo recovery dry-run artifacts (may contain signed URLs)
recovery-dry-run-output/

# Local label-scan prototype fixtures (may contain real device identifiers)
fixtures/label-scan/
lib/prototype/label-scan/fixtures/

# Tesseract trained data (downloaded by tesseract.js; do not commit)
eng.traineddata

# Local verification / UX audit screenshots (generated)
tmp-product-files-verification/
tmp-ux-audit-screenshots/
