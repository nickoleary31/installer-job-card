# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local draft photo recovery dry-run artifacts (may contain signed URLs)
recovery-dry-run-output/

# Tesseract trained data (downloaded by tesseract.js; local OCR prototype only)
eng.traineddata

# Local verification / UX audit screenshots (generated)
tmp-product-files-verification/
tmp-ux-audit-screenshots/

# Local label-scan fixtures (may contain real device identifiers; OCR branch)
fixtures/label-scan/
