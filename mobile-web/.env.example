# Same contract as the root app's Supabase client (lib/supabase/client.ts).
# The anon key is public/RLS-protected by design — not a secret — but is
# kept out of git anyway to avoid drift from the real project's values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The hosted Installer Sheetz origin this static build calls for /api/**
# (see lib/api-base.ts) and that lib/app-routes.ts uses to pick static
# query-param routes instead of the web app's dynamic [param] routes.
# A public hostname, not a secret. Leave unset for the web app (same-origin).
NEXT_PUBLIC_API_ORIGIN=
